# ─────────────────────────────────────────────────────────────────────────────
# LogForge Backend — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Connection string (REQUIRED)
# Local  : mongodb://localhost:27017/
# Docker : mongodb://mongo:27017/
MONGO_URL=mongodb://localhost:27017/

# Database name (REQUIRED)
DB_NAME=logforge

# ── Elasticsearch / OpenSearch ────────────────────────────────────────────────
# Base URL (REQUIRED)
# Local  : http://localhost:9200
# TLS    : https://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200

# Credentials — required if Elasticsearch security is enabled
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Path to CA certificate — required for TLS setups
# Place the file at config/cert/elasticsearch_ca.crt
ELASTICSEARCH_CA_CERT=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED — Long random secret used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# The server will refuse to start if this is empty.
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Development : http://localhost:3000
# Production  : https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ── Email / Frontend URL ─────────────────────────────────────────────────────
# Base URL of the frontend — used in invitation and password-reset email links.
# Development : http://localhost:3000
# Production  : https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000

# ── OAuth — GitHub ───────────────────────────────────────────────────────────
# Optional — leave empty to disable GitHub login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# ── OAuth — GitLab ───────────────────────────────────────────────────────────
# Optional — leave empty to disable GitLab login
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=
